{
  "entities": {
    "BankAccount": {
      "title": "BankAccount",
      "description": "Bank account details configured by Admin for accepting payments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bank_name": { "type": "string" },
        "account_holder": { "type": "string" },
        "account_number": { "type": "string" },
        "ifsc_code": { "type": "string" },
        "branch": { "type": "string" },
        "priority": { "type": "number" },
        "daily_limit": { "type": "number" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "created_at": { "type": "string" }
      },
      "required": ["id", "bank_name", "account_holder", "account_number", "ifsc_code", "status"]
    },
    "UpiAccount": {
      "title": "UpiAccount",
      "description": "UPI handle and QR details configured by Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "upi_id": { "type": "string" },
        "upi_app": { "type": "string" },
        "qr_url": { "type": "string" },
        "priority": { "type": "number" },
        "daily_limit": { "type": "number" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "created_at": { "type": "string" }
      },
      "required": ["id", "upi_id", "upi_app", "status"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit trail log of admin operations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_name": { "type": "string" },
        "user_id": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "user_name", "action"]
    },
    "Client": {
      "title": "Client",
      "description": "Client profile created by Admin with login credentials and assigned accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "full_name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "password": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "disabled"] },
        "created_at": { "type": "string" }
      },
      "required": ["id", "full_name", "email", "status"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Transaction payment proof submitted by clients or payers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "client_id": { "type": "string" },
        "client_name": { "type": "string" },
        "amount": { "type": "number" },
        "utr_number": { "type": "string" },
        "payment_method": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "created_at": { "type": "string" }
      },
      "required": ["id", "amount", "utr_number", "status"]
    },
    "PaymentLink": {
      "title": "PaymentLink",
      "description": "Shareable payment link generated by admin or client",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "title", "status"]
    }
  },
  "firestore": {
    "/bank_accounts/{id}": {
      "schema": "BankAccount",
      "description": "Collection of configured bank accounts"
    },
    "/upi_accounts/{id}": {
      "schema": "UpiAccount",
      "description": "Collection of configured UPI accounts"
    },
    "/activity_logs/{id}": {
      "schema": "ActivityLog",
      "description": "Audit log entries"
    },
    "/clients/{id}": {
      "schema": "Client",
      "description": "Clients registered in CRM portal"
    },
    "/transactions/{id}": {
      "schema": "Transaction",
      "description": "Payment transactions and UTR submissions"
    },
    "/payment_links/{id}": {
      "schema": "PaymentLink",
      "description": "Payment links generated by users"
    }
  }
}
